<Application x:Class="Vigil.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Pure Monochrome (Black & White) Design Tokens -->
        <Color x:Key="ColorSurfaceBase">#0B0C0E</Color>
        <Color x:Key="ColorSurfaceCard">#13141B</Color>
        <Color x:Key="ColorSurfaceCardHover">#1A1C24</Color>
        <Color x:Key="ColorBorderHairline">#14FFFFFF</Color>
        <Color x:Key="ColorBorderLight">#26FFFFFF</Color>
        <Color x:Key="ColorBorderActive">#4DFFFFFF</Color>

        <!-- Monochrome Text & Accent Palette -->
        <Color x:Key="ColorTextWhite">#FFFFFF</Color>
        <Color x:Key="ColorTextSilver">#D4D7E0</Color>
        <Color x:Key="ColorTextMuted">#868C9E</Color>
        <Color x:Key="ColorTextDim">#4A5060</Color>

        <!-- Aliased Accents for Pure Black & White Contrast -->
        <Color x:Key="ColorAccentCyan">#FFFFFF</Color>
        <Color x:Key="ColorAccentLime">#FFFFFF</Color>
        <Color x:Key="ColorAccentEmerald">#FFFFFF</Color>
        <Color x:Key="ColorAccentRose">#CCCCCC</Color>

        <SolidColorBrush x:Key="BrushSurfaceBase" Color="{StaticResource ColorSurfaceBase}" />
        <SolidColorBrush x:Key="BrushSurfaceCard" Color="{StaticResource ColorSurfaceCard}" />
        <SolidColorBrush x:Key="BrushSurfaceCardHover" Color="{StaticResource ColorSurfaceCardHover}" />
        <SolidColorBrush x:Key="BrushBorderHairline" Color="{StaticResource ColorBorderHairline}" />
        <SolidColorBrush x:Key="BrushBorderLight" Color="{StaticResource ColorBorderLight}" />
        <SolidColorBrush x:Key="BrushBorderActive" Color="{StaticResource ColorBorderActive}" />

        <SolidColorBrush x:Key="BrushTextWhite" Color="{StaticResource ColorTextWhite}" />
        <SolidColorBrush x:Key="BrushTextSilver" Color="{StaticResource ColorTextSilver}" />
        <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}" />
        <SolidColorBrush x:Key="BrushTextDim" Color="{StaticResource ColorTextDim}" />

        <SolidColorBrush x:Key="BrushAccentCyan" Color="{StaticResource ColorAccentCyan}" />
        <SolidColorBrush x:Key="BrushAccentLime" Color="{StaticResource ColorAccentLime}" />
        <SolidColorBrush x:Key="BrushAccentEmerald" Color="{StaticResource ColorAccentEmerald}" />
        <SolidColorBrush x:Key="BrushAccentRose" Color="{StaticResource ColorAccentRose}" />

        <FontFamily x:Key="FontPlusJakarta">Plus Jakarta Sans, Segoe UI, sans-serif</FontFamily>
        <FontFamily x:Key="FontMono">JetBrains Mono, Consolas, monospace</FontFamily>

        <!-- Tactile Monochrome Bento Toggle Switch -->
        <Style x:Key="BentoToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="38" Height="22">
                            <Border x:Name="BackgroundBorder" 
                                    Background="#181A22" 
                                    BorderBrush="#26FFFFFF" 
                                    BorderThickness="1" 
                                    CornerRadius="11" />
                            <Ellipse x:Name="Thumb" 
                                     Width="16" Height="16" 
                                     Fill="#6E7485" 
                                     HorizontalAlignment="Left" 
                                     Margin="3,0,0,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="Background" Value="#FFFFFF" />
                                <Setter TargetName="BackgroundBorder" Property="BorderBrush" Value="#FFFFFF" />
                                <Setter TargetName="Thumb" Property="Fill" Value="#0B0C0E" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bento Preset Button -->
        <Style x:Key="BentoPresetBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="{StaticResource FontPlusJakarta}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextSilver}" />
            <Setter Property="Background" Value="#10FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorderHairline}" />
            <Setter Property="Padding" Value="0,6" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#22FFFFFF" />
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{StaticResource BrushBorderLight}" />
                                <Setter Property="Foreground" Value="{StaticResource BrushTextWhite}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#33FFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource BrushTextWhite}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bento Action Primary Button (Solid White) -->
        <Style x:Key="BentoActionBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="{StaticResource FontPlusJakarta}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#0B0C0E" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder" Property="Background" Value="#E5E7EB" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionBorder" Property="Background" Value="#D1D5DB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bento Monochrome End/Cancel Button -->
        <Style x:Key="BentoDangerBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="{StaticResource FontPlusJakarta}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextSilver}" />
            <Setter Property="Background" Value="#161820" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorderLight}" />
            <Setter Property="Padding" Value="0,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DangerBorder" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DangerBorder" Property="Background" Value="#222532" />
                                <Setter TargetName="DangerBorder" Property="BorderBrush" Value="{StaticResource BrushBorderActive}" />
                                <Setter Property="Foreground" Value="{StaticResource BrushTextWhite}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="DangerBorder" Property="Background" Value="#101116" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Header Window Control Buttons (Minimize & Close) -->
        <Style x:Key="WindowCtrlBtn" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#12FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#26FFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource BrushTextWhite}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#38FFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource BrushTextWhite}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
