<Application x:Class="Vigil.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Design Tokens translated to XAML Resources -->
        <Color x:Key="ColorSurfaceBase">#0F1015</Color>
        <Color x:Key="ColorSurfaceCard">#1A1C26</Color>
        <Color x:Key="ColorSurfaceCardHover">#222533</Color>
        <Color x:Key="ColorBorderHairline">#1FFFFFFF</Color>
        <Color x:Key="ColorBorderLight">#26FFFFFF</Color>
        <Color x:Key="ColorAccentCyan">#00D2EB</Color>
        <Color x:Key="ColorAccentLime">#84CC16</Color>
        <Color x:Key="ColorAccentEmerald">#10B981</Color>
        <Color x:Key="ColorAccentRose">#F43F5E</Color>
        <Color x:Key="ColorTextWhite">#FFFFFF</Color>
        <Color x:Key="ColorTextMuted">#8B92A4</Color>
        <Color x:Key="ColorTextDim">#545B6D</Color>

        <SolidColorBrush x:Key="BrushSurfaceBase" Color="{StaticResource ColorSurfaceBase}" />
        <SolidColorBrush x:Key="BrushSurfaceCard" Color="{StaticResource ColorSurfaceCard}" />
        <SolidColorBrush x:Key="BrushSurfaceCardHover" Color="{StaticResource ColorSurfaceCardHover}" />
        <SolidColorBrush x:Key="BrushBorderHairline" Color="{StaticResource ColorBorderHairline}" />
        <SolidColorBrush x:Key="BrushBorderLight" Color="{StaticResource ColorBorderLight}" />
        <SolidColorBrush x:Key="BrushAccentCyan" Color="{StaticResource ColorAccentCyan}" />
        <SolidColorBrush x:Key="BrushAccentLime" Color="{StaticResource ColorAccentLime}" />
        <SolidColorBrush x:Key="BrushAccentEmerald" Color="{StaticResource ColorAccentEmerald}" />
        <SolidColorBrush x:Key="BrushAccentRose" Color="{StaticResource ColorAccentRose}" />
        <SolidColorBrush x:Key="BrushTextWhite" Color="{StaticResource ColorTextWhite}" />
        <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}" />
        <SolidColorBrush x:Key="BrushTextDim" Color="{StaticResource ColorTextDim}" />

        <FontFamily x:Key="FontPlusJakarta">Plus Jakarta Sans, Segoe UI, sans-serif</FontFamily>
        <FontFamily x:Key="FontMono">JetBrains Mono, Consolas, monospace</FontFamily>

        <!-- Tactile iOS/macOS Bento Toggle Switch -->
        <Style x:Key="BentoToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="38" Height="22">
                            <Border x:Name="BackgroundBorder" 
                                    Background="#222533" 
                                    BorderBrush="#26FFFFFF" 
                                    BorderThickness="1" 
                                    CornerRadius="11" />
                            <Ellipse x:Name="Thumb" 
                                     Width="16" Height="16" 
                                     Fill="#FFFFFF" 
                                     HorizontalAlignment="Left" 
                                     Margin="3,0,0,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="Background" Value="#10B981" />
                                <Setter TargetName="BackgroundBorder" Property="BorderBrush" Value="#20D494" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bento Preset Button -->
        <Style x:Key="BentoPresetBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="{StaticResource FontPlusJakarta}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextWhite}" />
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorderHairline}" />
            <Setter Property="Padding" Value="0,6" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#22FFFFFF" />
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{StaticResource BrushBorderLight}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bento Action Primary Button -->
        <Style x:Key="BentoActionBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="{StaticResource FontPlusJakarta}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#090A0F" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionBorder" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bento Danger Button -->
        <Style x:Key="BentoDangerBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="{StaticResource FontPlusJakarta}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource BrushAccentRose}" />
            <Setter Property="Background" Value="#26F43F5E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#4DF43F5E" />
            <Setter Property="Padding" Value="0,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DangerBorder" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DangerBorder" Property="Background" Value="#3DF43F5E" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="DangerBorder" Property="Background" Value="#4DF43F5E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
