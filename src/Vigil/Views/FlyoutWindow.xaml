<Window x:Class="Vigil.Views.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vigil"
        Width="320"
        Height="395"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanMinimize"
        ShowInTaskbar="True"
        Icon="pack://application:,,,/assets/icon.png"
        Topmost="True"
        FontFamily="{StaticResource FontPlusJakarta}">

    <!-- Window Outer DropShadow Canvas (Draggable Anywhere) -->
    <Border Margin="10"
            Background="#F7121316"
            CornerRadius="14"
            BorderBrush="{StaticResource BrushBorderLight}"
            BorderThickness="1"
            MouseLeftButtonDown="Window_MouseDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" Direction="270" ShadowDepth="8" Opacity="0.75" Color="#000000" />
        </Border.Effect>

        <Grid Margin="16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- 0: Minimalist Header -->
                <RowDefinition Height="Auto" /> <!-- 1: Divider -->
                <RowDefinition Height="Auto" /> <!-- 2: Hero Timer & Actions -->
                <RowDefinition Height="Auto" /> <!-- 3: Divider -->
                <RowDefinition Height="*" />    <!-- 4: Clean Flat Status Rows -->
                <RowDefinition Height="Auto" /> <!-- 5: Divider -->
                <RowDefinition Height="Auto" /> <!-- 6: Minimalist Footer -->
            </Grid.RowDefinitions>

            <!-- 0: Header (Spacious, Minimalist) -->
            <Grid Grid.Row="0" Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource BrushSurfaceCard}" BorderBrush="{StaticResource BrushBorderHairline}" BorderThickness="1" Margin="0,0,8,0" ClipToBounds="True">
                        <Image Source="pack://application:,,,/assets/icon.png" RenderOptions.BitmapScalingMode="HighQuality" Stretch="UniformToFill" Margin="1" />
                    </Border>
                    <TextBlock Text="Vigil" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushTextWhite}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Border x:Name="PillAutoBadge" Background="#16181D" BorderBrush="{StaticResource BrushBorderHairline}" BorderThickness="1" CornerRadius="4" Padding="5,1.5" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtAutoPilotBadge" Text="STANDBY" FontFamily="{StaticResource FontMono}" FontSize="8" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" />
                    </Border>
                </StackPanel>

                <!-- Controls: Master Switch & Close -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtMasterSwitchLabel" Text="OFF" FontFamily="{StaticResource FontMono}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource BrushTextDim}" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <CheckBox x:Name="ChkMasterVigil" Style="{StaticResource BentoToggleSwitch}" IsChecked="False" VerticalAlignment="Center" ToolTip="Toggle Clamshell Guard ON / OFF" Margin="0,0,10,0" />
                    <Button x:Name="BtnCloseFlyout" Click="BtnCloseFlyout_Click" Style="{StaticResource WindowCtrlBtn}" ToolTip="Close to Tray">
                        <Path Data="M3 3 L11 11 M11 3 L3 11" Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="8" Height="8" Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 1: Divider -->
            <Border Grid.Row="1" Height="1" Background="{StaticResource BrushBorderHairline}" Margin="0,10,0,12" />

            <!-- 2: Hero Countdown Timer & Presets -->
            <StackPanel Grid.Row="2" Margin="0,0,0,2">
                <TextBlock x:Name="TxtTimerDigits" Text="--:--:--" FontFamily="{StaticResource FontMono}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource BrushTextWhite}" HorizontalAlignment="Center" Margin="0,0,0,2" />
                <TextBlock x:Name="TxtTargetStatus" Text="System Standby" FontSize="11" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,0,0,12" />

                <!-- Duration Preset Chips (Pills) -->
                <UniformGrid Columns="5" Margin="0,0,0,10">
                    <Button Click="Preset_Click" Tag="1800" Content="30m" Style="{StaticResource BentoPresetBtn}" />
                    <Button Click="Preset_Click" Tag="3600" Content="1h" Style="{StaticResource BentoPresetBtn}" />
                    <Button Click="Preset_Click" Tag="7200" Content="2h" Style="{StaticResource BentoPresetBtn}" />
                    <Button Click="Preset_Click" Tag="14400" Content="4h" Style="{StaticResource BentoPresetBtn}" />
                    <Button Click="Preset_Click" Tag="-1" Content="∞" Style="{StaticResource BentoPresetBtn}" />
                </UniformGrid>

                <!-- Clean Action Buttons -->
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="BtnAdd30" Click="BtnAdd30_Click" Content="+30m" Style="{StaticResource BentoActionBtn}" Height="30" />
                    <Button Grid.Column="2" x:Name="BtnEndSession" Click="BtnEndSession_Click" Content="Stop (ESC)" Style="{StaticResource BentoDangerBtn}" Height="30" />
                </Grid>
            </StackPanel>

            <!-- 3: Divider -->
            <Border Grid.Row="3" Height="1" Background="{StaticResource BrushBorderHairline}" Margin="0,12,0,8" />

            <!-- 4: Clean Flat Status Rows (No heavy boxes, spacious & breathable) -->
            <StackPanel Grid.Row="4" VerticalAlignment="Center">
                <!-- Row 1: CPU Package -->
                <Grid Margin="0,5">
                    <TextBlock Text="CPU Package" FontSize="11" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtTempDigits" Text="--°C" FontFamily="{StaticResource FontMono}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextWhite}" Margin="0,0,6,0" />
                        <TextBlock x:Name="TxtTempStatus" Text="92% Cap" FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="{StaticResource BrushTextSilver}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="{StaticResource BrushBorderHairline}" Margin="0,2" />

                <!-- Row 2: Wi-Fi Watchdog -->
                <Grid Margin="0,5">
                    <TextBlock Text="Wi-Fi Watchdog" FontSize="11" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtWifiStatus" Text="Connected (14ms)" FontFamily="{StaticResource FontMono}" FontSize="10.5" Foreground="{StaticResource BrushTextSilver}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <CheckBox x:Name="ChkAutoWifi" Style="{StaticResource BentoToggleSwitch}" IsChecked="True" VerticalAlignment="Center" ToolTip="Toggle Wi-Fi ping watchdog" />
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="{StaticResource BrushBorderHairline}" Margin="0,2" />

                <!-- Row 3: Power Source -->
                <Grid Margin="0,5">
                    <TextBlock Text="Power Source" FontSize="11" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtBatStatus" Text="AC Power (100%)" FontFamily="{StaticResource FontMono}" FontSize="10.5" Foreground="{StaticResource BrushTextSilver}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>

            <!-- 5: Divider -->
            <Border Grid.Row="5" Height="1" Background="{StaticResource BrushBorderHairline}" Margin="0,8,0,8" />

            <!-- 6: Minimalist Footer -->
            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkAutoStart" Style="{StaticResource BentoToggleSwitch}" IsChecked="False" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Start on boot" FontSize="10" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="v1.0.0" FontFamily="{StaticResource FontMono}" FontSize="9.5" Foreground="{StaticResource BrushTextDim}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

        </Grid>
    </Border>
</Window>
