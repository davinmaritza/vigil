<Window x:Class="Vigil.Views.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vigil"
        Width="268"
        Height="208"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Icon="pack://application:,,,/assets/icon.png"
        Topmost="True"
        FontFamily="{StaticResource FontPlusJakarta}">

    <!-- Window Outer DropShadow Canvas (Draggable Anywhere) -->
    <Border Margin="8"
            Background="#F7121316"
            CornerRadius="12"
            BorderBrush="{StaticResource BrushBorderLight}"
            BorderThickness="1"
            MouseLeftButtonDown="Window_MouseDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Direction="270" ShadowDepth="6" Opacity="0.75" Color="#000000" />
        </Border.Effect>

        <Grid Margin="12,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- 0: Header -->
                <RowDefinition Height="Auto" /> <!-- 1: Divider -->
                <RowDefinition Height="Auto" /> <!-- 2: Countdown Timer & Subtitle -->
                <RowDefinition Height="Auto" /> <!-- 3: Presets Chips -->
                <RowDefinition Height="Auto" /> <!-- 4: Action Buttons -->
                <RowDefinition Height="Auto" /> <!-- 5: Divider -->
                <RowDefinition Height="Auto" /> <!-- 6: Micro Telemetry Footer -->
            </Grid.RowDefinitions>

            <!-- 0: Header (Compact Menu Bar Style) -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="18" Height="18" CornerRadius="4" Background="{StaticResource BrushSurfaceCard}" BorderBrush="{StaticResource BrushBorderHairline}" BorderThickness="1" Margin="0,0,6,0" ClipToBounds="True">
                        <Image Source="pack://application:,,,/assets/icon.png" RenderOptions.BitmapScalingMode="HighQuality" Stretch="UniformToFill" Margin="0.5" />
                    </Border>
                    <TextBlock Text="Vigil" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource BrushTextWhite}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Border x:Name="PillAutoBadge" Background="#16181D" BorderBrush="{StaticResource BrushBorderHairline}" BorderThickness="1" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtAutoPilotBadge" Text="STANDBY" FontFamily="{StaticResource FontMono}" FontSize="7.5" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" />
                    </Border>
                </StackPanel>

                <!-- Controls: Master Switch, Settings & Close -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtMasterSwitchLabel" Text="OFF" FontFamily="{StaticResource FontMono}" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource BrushTextDim}" Margin="0,0,5,0" VerticalAlignment="Center" />
                    <CheckBox x:Name="ChkMasterVigil" Style="{StaticResource BentoToggleSwitch}" IsChecked="False" VerticalAlignment="Center" ToolTip="Toggle Clamshell Guard ON / OFF" Margin="0,0,6,0" />
                    <Button x:Name="BtnSettings" Click="BtnSettings_Click" Style="{StaticResource WindowCtrlBtn}" Width="18" Height="18" ToolTip="Configuration &amp; Settings" Margin="0,0,4,0">
                        <Path Data="M8 5a3 3 0 1 0 0 6 3 3 0 0 0 0-6zm-6 3a6 6 0 1 1 12 0 6 6 0 0 1-12 0z" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="7" Height="7" Stretch="Uniform" />
                    </Button>
                    <Button x:Name="BtnCloseFlyout" Click="BtnCloseFlyout_Click" Style="{StaticResource WindowCtrlBtn}" Width="18" Height="18" ToolTip="Close (ESC)">
                        <Path Data="M3 3 L11 11 M11 3 L3 11" Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="7" Height="7" Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 1: Divider -->
            <Border Grid.Row="1" Height="1" Background="{StaticResource BrushBorderHairline}" Margin="0,6,0,6" />

            <!-- 2: Countdown Timer & Subtitle (Centered, Spacious) -->
            <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,6">
                <TextBlock x:Name="TxtTimerDigits" Text="--:--:--" FontFamily="{StaticResource FontMono}" FontSize="23" FontWeight="Bold" Foreground="{StaticResource BrushTextWhite}" HorizontalAlignment="Center" />
                <TextBlock x:Name="TxtTargetStatus" Text="System Standby" FontSize="9.5" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,1,0,0" />
            </StackPanel>

            <!-- 3: Duration Presets (Clean Chips) -->
            <UniformGrid Grid.Row="3" Columns="5" Margin="0,0,0,6">
                <Button Click="Preset_Click" Tag="1800" Content="30m" Style="{StaticResource BentoPresetBtn}" Height="20" FontSize="10" Padding="0" />
                <Button Click="Preset_Click" Tag="3600" Content="1h" Style="{StaticResource BentoPresetBtn}" Height="20" FontSize="10" Padding="0" />
                <Button Click="Preset_Click" Tag="7200" Content="2h" Style="{StaticResource BentoPresetBtn}" Height="20" FontSize="10" Padding="0" />
                <Button Click="Preset_Click" Tag="14400" Content="4h" Style="{StaticResource BentoPresetBtn}" Height="20" FontSize="10" Padding="0" />
                <Button Click="Preset_Click" Tag="-1" Content="∞" Style="{StaticResource BentoPresetBtn}" Height="20" FontSize="10" Padding="0" />
            </UniformGrid>

            <!-- 4: Action Buttons (Two Wide Columns) -->
            <Grid Grid.Row="4" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="BtnAdd30" Click="BtnAdd30_Click" Content="+30m" Style="{StaticResource BentoActionBtn}" Height="25" FontSize="10.5" />
                <Button Grid.Column="2" x:Name="BtnEndSession" Click="BtnEndSession_Click" Content="Stop (ESC)" Style="{StaticResource BentoDangerBtn}" Height="25" FontSize="10.5" />
            </Grid>

            <!-- 5: Divider -->
            <Border Grid.Row="5" Height="1" Background="{StaticResource BrushBorderHairline}" Margin="0,5,0,5" />

            <!-- 6: Micro Telemetry Footer (Single Concise Line) -->
            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: CPU Package -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTempDigits" Text="--°C" FontFamily="{StaticResource FontMono}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource BrushTextWhite}" Margin="0,0,4,0" />
                    <TextBlock x:Name="TxtTempStatus" Text="92% Cap" FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="{StaticResource BrushTextDim}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Middle: Wi-Fi -->
                <TextBlock Grid.Column="1" x:Name="TxtWifiStatus" Text="14ms" FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="{StaticResource BrushTextSilver}" HorizontalAlignment="Center" VerticalAlignment="Center" />

                <!-- Right: Battery/Power -->
                <TextBlock Grid.Column="2" x:Name="TxtBatStatus" Text="AC (100%)" FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="{StaticResource BrushTextSilver}" VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Border>
</Window>
