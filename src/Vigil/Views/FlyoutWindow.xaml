<Window x:Class="Vigil.Views.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vigil"
        Width="430"
        Height="620"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="{StaticResource FontPlusJakarta}">

    <!-- Window Outer DropShadow Canvas -->
    <Border Margin="14"
            Background="#E610121A"
            CornerRadius="24"
            BorderBrush="{StaticResource BrushBorderLight}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" Direction="270" ShadowDepth="12" Opacity="0.75" Color="#000000" />
        </Border.Effect>

        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- 0: Header -->
                <RowDefinition Height="Auto" /> <!-- 1: AutoPilot Strip -->
                <RowDefinition Height="Auto" /> <!-- 2: Bento Row (Thermal & WiFi) -->
                <RowDefinition Height="Auto" /> <!-- 3: Battery Card -->
                <RowDefinition Height="Auto" /> <!-- 4: Options / Startup Strip -->
                <RowDefinition Height="Auto" /> <!-- 5: Freezer Strip -->
                <RowDefinition Height="*" />    <!-- 6: Timer HUD & Actions -->
            </Grid.RowDefinitions>

            <!-- 0: Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource BrushSurfaceCard}" BorderBrush="{StaticResource BrushBorderHairline}" BorderThickness="1" Margin="0,0,10,0" ClipToBounds="True">
                        <Image Source="pack://application:,,,/assets/icon.png" RenderOptions.BitmapScalingMode="HighQuality" Stretch="UniformToFill" Margin="2" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Vigil" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushTextWhite}" />
                        <TextBlock x:Name="TxtHeaderSub" Text="Lid-Close Awake • Display Off" FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" x:Name="BtnCloseFlyout" Click="BtnCloseFlyout_Click" Width="28" Height="28" Background="#14FFFFFF" BorderThickness="0" Foreground="{StaticResource BrushTextMuted}" Content="✕" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CloseBorder" Background="{TemplateBinding Background}" CornerRadius="14">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CloseBorder" Property="Background" Value="#26FFFFFF" />
                                    <Setter Property="Foreground" Value="{StaticResource BrushTextWhite}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- 1: AutoPilot Strip -->
            <Border Grid.Row="1" Background="{StaticResource BrushSurfaceCard}" BorderBrush="{StaticResource BrushBorderHairline}" BorderThickness="1" CornerRadius="12" Padding="12,9" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="DotStatus" Width="8" Height="8" Fill="{StaticResource BrushAccentEmerald}" Margin="0,0,8,0" />
                        <TextBlock x:Name="TxtTargetProcess" Text="blender.exe" FontWeight="Bold" FontSize="12" Foreground="{StaticResource BrushTextWhite}" />
                        <TextBlock x:Name="TxtTargetDesc" Text=" • Rendering Active" FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
                    </StackPanel>

                    <Border Grid.Column="1" Background="#2610B981" CornerRadius="6" Padding="6,2">
                        <TextBlock x:Name="TxtAutoPilotBadge" Text="AUTO-PILOT" FontFamily="{StaticResource FontMono}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushAccentEmerald}" />
                    </Border>
                </Grid>
            </Border>

            <!-- 2: Bento Row (Thermal & WiFi) -->
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Thermal Box -->
                <Border Grid.Column="0" Background="{StaticResource BrushSurfaceCard}" BorderBrush="{StaticResource BrushBorderHairline}" BorderThickness="1" CornerRadius="14" Padding="12">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="CPU Temp" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}" />
                            <Border HorizontalAlignment="Right" Background="#2200D2EB" CornerRadius="4" Padding="5,1">
                                <TextBlock x:Name="TxtPillThrottle" Text="CAP 92%" FontFamily="{StaticResource FontMono}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushAccentCyan}" />
                            </Border>
                        </Grid>
                        <TextBlock x:Name="TxtTempDigits" Text="64°C" FontFamily="{StaticResource FontMono}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource BrushTextWhite}" Margin="0,2" />
                        <TextBlock x:Name="TxtTempStatus" Text="Turbo OFF • Cold" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushAccentEmerald}" />
                    </StackPanel>
                </Border>

                <!-- Wi-Fi Box -->
                <Border Grid.Column="2" Background="{StaticResource BrushSurfaceCard}" BorderBrush="{StaticResource BrushBorderHairline}" BorderThickness="1" CornerRadius="14" Padding="12">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Path Data="M1 9l2 2c4.97-4.97 13.03-4.97 18 0l2-2C17.93 3.93 6.07 3.93 1 9zm8 8l3 3 3-3c-1.66-1.66-4.34-1.66-6 0zm-4-4l2 2c2.76-2.76 7.24-2.76 10 0l2-2C15.14 9.14 8.86 9.14 5 13z"
                                  Fill="{StaticResource BrushAccentCyan}" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Left" />
                            <CheckBox x:Name="ChkAutoWifi" Style="{StaticResource BentoToggleSwitch}" IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock x:Name="TxtWifiSsid" Text="Home_Studio_5G" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushTextWhite}" TextTrimming="CharacterEllipsis" Margin="0,2" />
                        <TextBlock x:Name="TxtWifiPing" Text="14ms • Watchdog On" FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3: Battery Card -->
            <Border Grid.Row="3" Background="{StaticResource BrushSurfaceCard}" BorderBrush="{StaticResource BrushBorderHairline}" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtBatStatus" Text="⚡ AC Connected" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushAccentLime}" Margin="0,0,6,0" />
                            <TextBlock x:Name="TxtBatPct" Text="88%" FontFamily="{StaticResource FontMono}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextWhite}" />
                        </StackPanel>
                        <TextBlock x:Name="TxtBatRuntime" Text="~4h 20m left" FontSize="11" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Right" />
                    </Grid>

                    <!-- Battery Bar -->
                    <Border Height="8" Background="#1AFFFFFF" CornerRadius="4" ClipToBounds="True">
                        <ProgressBar x:Name="ProgressBattery" Value="88" Maximum="100" Height="8" BorderThickness="0" Background="Transparent" Foreground="{StaticResource BrushAccentLime}" />
                    </Border>

                    <Grid Margin="0,4,0,0">
                        <TextBlock Text="0%" FontSize="9" FontFamily="{StaticResource FontMono}" Foreground="{StaticResource BrushTextDim}" HorizontalAlignment="Left" />
                        <TextBlock Text="EcoQoS (40%)" FontSize="9" FontFamily="{StaticResource FontMono}" Foreground="{StaticResource BrushTextDim}" HorizontalAlignment="Center" />
                        <TextBlock Text="100%" FontSize="9" FontFamily="{StaticResource FontMono}" Foreground="{StaticResource BrushTextDim}" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 4: Options / Startup Strip -->
            <Border Grid.Row="4" Background="{StaticResource BrushSurfaceCard}" BorderBrush="{StaticResource BrushBorderHairline}" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚙ Start with Windows" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextWhite}" />
                        <TextBlock Text=" (Tray Icon)" FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
                    </StackPanel>

                    <CheckBox Grid.Column="1" x:Name="ChkAutoStart" Style="{StaticResource BentoToggleSwitch}" IsChecked="False" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- 5: Freezer Strip -->
            <Border Grid.Row="5" Background="#0DFFFFFF" BorderBrush="{StaticResource BrushBorderHairline}" BorderThickness="1" CornerRadius="10" Padding="12,7" Margin="0,0,0,12">
                <Grid>
                    <TextBlock Text="Suspended Apps:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Left" />
                    <TextBlock x:Name="TxtFrozenApps" Text="slack, discord, spotify" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{StaticResource BrushTextWhite}" HorizontalAlignment="Right" />
                </Grid>
            </Border>

            <!-- 6: Timer HUD & Actions -->
            <Border Grid.Row="6" Background="{StaticResource BrushSurfaceCard}" BorderBrush="{StaticResource BrushBorderHairline}" BorderThickness="1" CornerRadius="16" Padding="14">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SISA WAKTU SESI" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                    <TextBlock x:Name="TxtTimerDigits" Text="01:45:20" FontFamily="{StaticResource FontMono}" FontSize="36" FontWeight="Bold" Foreground="{StaticResource BrushTextWhite}" HorizontalAlignment="Center" Margin="0,0,0,10" />

                    <!-- Preset Chips -->
                    <UniformGrid Columns="5" Margin="0,0,0,12">
                        <Button Click="Preset_Click" Tag="1800" Content="30m" Style="{StaticResource BentoPresetBtn}" />
                        <Button Click="Preset_Click" Tag="3600" Content="1h" Style="{StaticResource BentoPresetBtn}" />
                        <Button Click="Preset_Click" Tag="7200" Content="2h" Style="{StaticResource BentoPresetBtn}" />
                        <Button Click="Preset_Click" Tag="14400" Content="4h" Style="{StaticResource BentoPresetBtn}" />
                        <Button Click="Preset_Click" Tag="-1" Content="∞" Style="{StaticResource BentoPresetBtn}" />
                    </UniformGrid>

                    <!-- Main Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" x:Name="BtnAdd30" Click="BtnAdd30_Click" Content="+30 Menit" Style="{StaticResource BentoActionBtn}" />
                        <Button Grid.Column="2" x:Name="BtnEndSession" Click="BtnEndSession_Click" Content="Akhiri" Style="{StaticResource BentoDangerBtn}" />
                    </Grid>
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</Window>
